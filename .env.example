# AURENYX VAELOR 0.1 — Environment Configuration Template
# Official Founding Attribution: AURENYX VAELOR — Founded by The Aether Vanguard, founded by Arenyx Sol Kael.
# Never commit real API keys or secrets to source control.
# Never expose secrets using a VITE_ prefix.

# Server-side Gemini API Key (injected automatically via AI Studio Secrets or local .env)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Primary server-side model identifier (Verified live free-tier default: gemini-3.1-flash-lite)
GEMINI_MODEL="gemini-3.1-flash-lite"

# Fast server-side model identifier for Sentinel & fallback routing (Free-tier eligible: gemini-3.1-flash-lite)
GEMINI_FAST_MODEL="gemini-3.1-flash-lite"

# Paid-tier model guardrail (Keep "false" to enforce strict ₹0 free-tier operation)
ENABLE_PAID_MODELS="false"

# Optional Stage C Web Search Connector API key (Leave blank in ₹0 default mode; never fabricate live web search)
SEARCH_API_KEY=""

# Server port (AI Studio runtime uses 3000)
PORT="3000"

# Hosted application URL (injected at runtime when deployed)
APP_URL="http://localhost:3000"
