# AURENYX VAELOR v0.3 — The Autonomous Intelligence Upgrade
# Secondary Brand Line: One Vision. Multiple Intelligences. A New Frontier.
# Official Founding Attribution: AURENYX VAELOR — Founded by The Aether Vanguard, founded by Arenyx Sol Kael.
# Never commit real API keys or secrets to source control.
# Never expose secrets using a VITE_ prefix.

# Server-side Gemini API Key (injected automatically via AI Studio Secrets or local .env)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Configurable default server-side model identifier (Free-tier eligible: gemini-3.1-flash-lite or gemini-3.8-flash)
VAELOR_DEFAULT_MODEL="gemini-3.1-flash-lite"
GEMINI_MODEL="gemini-3.1-flash-lite"

# Fast server-side model identifier for Sentinel & fallback routing
VAELOR_FAST_MODEL="gemini-3.1-flash-lite"
GEMINI_FAST_MODEL="gemini-3.1-flash-lite"

# Paid-tier model guardrail (Keep "false" to enforce strict ₹0 free-tier operation)
ENABLE_PAID_MODELS="false"

# Optional Local Mock Mode default (Keep "false" in normal use; UI toggle allows explicit simulated UI testing)
VAELOR_MOCK_MODE="false"

# Bounded Orchestrator & Concurrency Limits (v0.3 resource protection)
VAELOR_MAX_CONCURRENCY="4"
VAELOR_MAX_STAGES="4"
VAELOR_MAX_TOOL_CALLS="4"
VAELOR_MAX_TASK_MS="45000"

# Optional external search provider key (Gemini Search Grounding runs automatically on server when GEMINI_API_KEY supports it)
SEARCH_API_KEY=""

# Server port (AI Studio runtime uses 3000)
PORT="3000"

# Hosted application URL (injected at runtime when deployed)
APP_URL="http://localhost:3000"
