{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Non-PII account profile and workspace preferences owned by an authenticated Vaelor user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Immutable Firebase Auth UID of the account owner."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Display name shown inside the user's workspace."
        },
        "authProviders": {
          "type": "array",
          "description": "Bounded list (max 5) of linked Firebase provider IDs (e.g. google.com, password)."
        },
        "themePreference": {
          "type": "string",
          "enum": ["dark", "light"],
          "maxLength": 10,
          "description": "Preferred UI color theme."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Immutable server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "ownerId",
        "displayName",
        "authProviders",
        "themePreference",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII record for the user's verified email address and sign-in metadata.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Immutable Firebase Auth UID matching parent userId."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254,
          "description": "Account email address isolated from public profile fields."
        },
        "emailVerified": {
          "type": "boolean",
          "description": "Whether the user's email was verified according to Firebase Auth."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Immutable server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["ownerId", "email", "emailVerified", "createdAt", "updatedAt"]
    },
    "CloudProject": {
      "title": "CloudProject",
      "description": "User-owned Vaelor project workspace with reusable context brief and terminal archive lock.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Immutable Firebase Auth UID of the project owner."
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Project workspace title."
        },
        "objective": {
          "type": "string",
          "minLength": 4,
          "maxLength": 600,
          "description": "Primary objective and constraints of the project."
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 800,
          "description": "Optional summary description."
        },
        "brief": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2400,
          "description": "Optional reusable context brief injected into Chat."
        },
        "category": {
          "type": "string",
          "enum": ["software", "research", "strategy", "documentation"],
          "maxLength": 24,
          "description": "Primary domain classification."
        },
        "status": {
          "type": "string",
          "enum": ["active", "planning", "paused", "archived"],
          "maxLength": 16,
          "description": "Lifecycle status; 'archived' is a locked terminal state."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Immutable server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "ownerId",
        "name",
        "objective",
        "description",
        "brief",
        "category",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "CloudMemory": {
      "title": "CloudMemory",
      "description": "Explicitly saved user-approved memory note isolated per authenticated UID and optional projectId.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Immutable Firebase Auth UID of the memory owner."
        },
        "label": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Short label for the saved memory."
        },
        "content": {
          "type": "string",
          "minLength": 2,
          "maxLength": 1200,
          "description": "User-approved memory note content."
        },
        "category": {
          "type": "string",
          "enum": ["preference", "project-fact", "constraint", "note"],
          "maxLength": 24,
          "description": "Memory classification."
        },
        "memoryType": {
          "type": "string",
          "enum": ["note", "decision", "goal", "summary", "reference"],
          "maxLength": 16,
          "description": "Structured v0.4 memory artifact kind."
        },
        "projectId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128,
          "pattern": "^$|^[a-zA-Z0-9_\\-]+$",
          "description": "Immutable parent CloudProject ID (empty string when global)."
        },
        "referenceUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500,
          "description": "Optional verified HTTPS reference URL."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Immutable server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "ownerId",
        "label",
        "content",
        "category",
        "memoryType",
        "projectId",
        "referenceUrl",
        "createdAt",
        "updatedAt"
      ]
    },
    "CloudMission": {
      "title": "CloudMission",
      "description": "User-owned Mission Control run record with bounded execution counters and terminal completion lock.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Immutable Firebase Auth UID of the mission owner."
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Mission plan title."
        },
        "objective": {
          "type": "string",
          "minLength": 4,
          "maxLength": 2000,
          "description": "Structured mission objective."
        },
        "projectId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128,
          "pattern": "^$|^[a-zA-Z0-9_\\-]+$",
          "description": "Immutable parent CloudProject ID (empty string when workspace-global)."
        },
        "status": {
          "type": "string",
          "enum": [
            "planned",
            "awaiting_approval",
            "running",
            "paused",
            "completed",
            "blocked",
            "failed",
            "cancelled"
          ],
          "maxLength": 24,
          "description": "Mission execution status; 'completed' and 'cancelled' are locked terminal states."
        },
        "stepsUsed": {
          "type": "integer",
          "description": "Bounded subtask execution steps consumed (0..20)."
        },
        "maxSteps": {
          "type": "integer",
          "description": "Configured step ceiling (1..20)."
        },
        "modelCallsUsed": {
          "type": "integer",
          "description": "Bounded model calls consumed (0..20)."
        },
        "summary": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2400,
          "description": "Mission execution and Sentinel verification summary."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Immutable server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "ownerId",
        "title",
        "objective",
        "projectId",
        "status",
        "stepsUsed",
        "maxSteps",
        "modelCallsUsed",
        "summary",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Root user profile document containing non-PII display preferences."
    },
    "/users/{userId}/private/{infoId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Split PII subcollection storing the user's verified email address."
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": { "$ref": "#/entities/CloudProject" },
      "description": "User-owned cloud-persisted project workspaces."
    },
    "/users/{userId}/memories/{memoryId}": {
      "schema": { "$ref": "#/entities/CloudMemory" },
      "description": "User-owned cloud-persisted project and workspace memory notes."
    },
    "/users/{userId}/missions/{missionId}": {
      "schema": { "$ref": "#/entities/CloudMission" },
      "description": "User-owned cloud-persisted Mission Control workflow runs."
    }
  }
}
